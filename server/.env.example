# Copy this file to .env and fill in ONE of the keys below, then restart the server.

# --- Option 1: Google Gemini (FREE tier) ---
# Get a free key at https://aistudio.google.com/apikey (sign in with a Google account).
GEMINI_API_KEY=
# Optional: which Gemini model to use. If you get "model not found" or hit the
# free limit, try another model name from https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.8-flash

# --- Option 2: Claude (paid, pay-as-you-go) ---
# Get a key at https://platform.claude.com (needs prepaid credits).
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# If both keys are set, Gemini is used. To use Claude instead:
# AI_PROVIDER=claude
