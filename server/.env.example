# Copy this file to .env and paste your Claude API key.
# Get a key at https://platform.claude.com (Settings > API Keys). Needs prepaid credits.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use for calorie estimates.
# claude-opus-5-5 (default, most accurate) or claude-haiku-5-5 (much cheaper).
# CLAUDE_MODEL=claude-opus-5-5
